{
  "build": {
    "env": {
      "CI": ""
    }
  },
  "rewrites": [
    {
      "source": "/api/gemini/(.*)",
      "destination": "/api/gemini/$1"
    },
    {
      "source": "/api/(.*)",
      "destination": "https://familytree.67-211-210-8.sslip.io/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
